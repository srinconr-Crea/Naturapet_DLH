  "databricks": {
    "enabled": true,
    "cloud": "azure",
    "workspace_host": "https://adb-7405606739630987.7.azuredatabricks.net",
    "profile": "CREA_DEV",
    "target": "dev",
    "catalog": "naturapet_dev",
    "schema": null,
    "warehouse_id": null,
    "runtime": null,
    "spark_version": null,
    "python_version": null,
    "schema_pattern": "${var.domain_name}_${var.data_layer}",
    "default_bundle_domain": "comercial",
    "default_bundle_layer": "bronze",
    "runtime_note": "No hay spark_version fijado en los YAML de jobs; registrar DBR/Spark/Python reales antes de pruebas de runtime. Python local y CI no son la version del runtime remoto."
  },
  "workflow": {
    "orchestrator": ".agents/skills/Crea/orquestador/SKILL.md",
    "change_name": null,
    "roles": {
      "planner": ".codex/agents/planner.toml",
      "developer": ".codex/agents/developer.toml",
      "reviewer": ".codex/agents/reviewer.toml"
    },
    "max_active_agents": 1,
    "max_fix_rounds": 2,
    "require_manual_archive_approval": true,
    "require_plan_approval": true,
    "handoff_template": "docs/plantillas/handoff.md",
    "evidence_template": "docs/plantillas/evidencia-hu.md",
    "skills_by_role": {
      "planner": [
        "openspec-explore",
        "openspec-propose",
        "openspec-update-change"
      ],
      "developer": [
        "openspec-apply-change"
      ],
      "reviewer": [
        "openspec-verify-change",
        "openspec-sync-specs",
        "openspec-archive-change"
      ]
    },
    "planning_confirmation_policy": "preserve_openspec_skill_gates"
  },
  "validation": {
    "required_checks": [
      {
        "id": "kit-structure",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/crea/verificar-kit.ps1",
        "environment": "local",
        "when": "Cambios en kit, contexto, perfiles o contrato proyecto.json"
      },
      {
        "id": "openspec-list",
        "command": "openspec.cmd list --json",
        "environment": "local",
        "when": "Inicio/reanudacion de HU y cambios en artefactos OpenSpec"
      },
      {
        "id": "python-unit",
        "command": ".\\.venv\\Scripts\\python.exe -m pytest tests -q",
        "environment": "local",
        "when": "Cambios en src/, tests/ o logica Python compartida"
      },
      {
        "id": "bundle-dev",
        "command": "databricks bundle validate --strict --target dev --profile CREA_DEV",
        "environment": "databricks",
        "when": "Cambios en databricks.yml, resources/, rutas de notebooks o configuracion del bundle"
      }
    ],
    "example_checks": [],
    "no_checks_policy": "planner_define_before_apply",
    "require_runtime_tests_when_spark_changes": true
  },
  "practices": {
    "general": "docs/buenas-practicas/general.md",
